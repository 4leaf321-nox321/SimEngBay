# 이 파일을 .env 로 복사해서 쓴다. **BOM 없이 UTF-8 로 저장한다** —
# BOM 이 붙으면 첫 줄 키가 조용히 무시된다(app/config.py 주석 참고).
APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/simengbay
# 운영에서는 반드시 난수로 바꾼다. 기본값이면 기동을 거부한다.
JWT_SECRET=dev-only-insecure-secret-change-me

# 이 설치가 무슨 플랫폼인가 — 안 적으면 기본값(SimEngBay · simengbay).
# 개발에서는 확장을 전부 켜 두고 본다. Vite 개발 서버도 이 파일을 읽어 화면에 같은 값을 심는다.
# APP_SLUG=simengbay
# APP_NAME=SimEngBay
# APP_TAGLINE=
# EXTENSIONS=sample

# --- 해석 작업 (로드맵 1단계) ---
# 단계를 어디서 돌리나 — fake(시험 · Ansys 없는 PC) · local · windows-bridge.
# 개발 PC 는 Ansys 가 Windows 에만 있어 1.5단계부터 windows-bridge 를 쓴다(docs/해석-연동-계획.md 3.1).
SIMULATION_EXECUTOR=fake
# 이 워커가 집을 솔버(쉼표로 여럿). 비우면 이 기계에 깔린 것 전부(gmsh · ccx 가 없으면 CalculiX 를 뺀다).
# **Ansys 는 라이선스가 하나라 워커도 하나**, CalculiX 는 코어 수만큼 띄울 수 있다 —
# 운영에서는 워커마다 `worker-<N>.env` 에 적어 갈라 띄운다(deploy/README_OPERATOR.md).
# SIMULATION_SOLVERS=calculix
# gmsh · CalculiX 를 손으로 받아 둔 자리(이미지에 깔려 있으면 필요 없다). 워커마다 다를 수 있어 서버 화면에는 없고,
# 워커가 단계 자식의 환경으로 넘긴다(프로세스 환경 · worker-<N>.env 에 같은 이름이 있으면 그것이 이긴다).
# GMSH_BIN=/usr/bin/gmsh
# CCX_BIN=/usr/bin/ccx
# OS 패키지를 루트 없이 풀어 쓸 때 ccx 가 따라올 라이브러리 자리(ccx 의 LD_LIBRARY_PATH 가 된다).
# OPENSOLVER_LD_PATH=
# ── 아래 해석 조정값(스레드 · CALCULIX_* · STE 주소 · 앱 · 폴링 · 메모리 상한)은 **서버 화면 「해석 설정」 에서
# 고치는 것이 먼저**다(재시작 없이). 여기 적은 값은 둘째 단 — 서버 화면에서 지우면 이 값으로 돌아간다. 결과를
# 바꾸는 값(본딩 · 선형 솔버 · 허용오차 · 스레드 · STE 메모리 상한)은 작업을 만들 때 그 작업에 고정된다.
# CalculiX 한 점의 스레드 수. 비우면 2(DOE 여러 점을 동시에 푼다 — 한 점이 기계를 독차지하지 않게).
# OMP_NUM_THREADS=2
# CalculiX 경로의 형상 맞춤 허용오차(mm) — 이보다 작은 바디끼리 겹침 · 틈은 맞닿은 것으로 붙인다.
# 비우면 CompCore 형상 점검의 「바디 사이 틈」(study.json 의 checks.contact_gap, 기본 0.001). 0 이면 끈다.
# 설계 틈새(핸드폰 부품 0.05 ~ 0.2 mm)까지 닫지 않게 작게.
# CALCULIX_BOOLEAN_TOLERANCE_MM=
# CalculiX 정적의 선형 솔버 — auto(메모리를 어림해 넘칠 것 같으면 반복 솔버) · spooles · iterative.
# 강체 묶음(원격점 · 강체) · 원통 지지가 든 덱은 iterative 여도 직접 솔버로 푼다(반력이 틀렸다).
# CALCULIX_LINEAR_SOLVER=auto
# CalculiX 의 본딩 — lever(바디를 따로 메시하고 간극을 둔 채 구속식, 기본) · tie(v0.30: *TIE 로 종 절점을
# 주 면 위로 옮긴다) · shared(옛 방식: 맞닿은 면을 쪼개 절점 공유). tie · shared 는 견줄 때만 — shared 는
# 선언한 접촉 쌍 · pinball · 파트별 메시가 안 듣는다.
# CALCULIX_BONDING=lever
# STE(Slurm 클러스터)에서 CalculiX 솔브 — 스펙 `solve_on: ste` 인 작업만(요청서 2026-11-24). 작업을 건 사람
# 명의로만 낸다: 아래 비밀로 STE `POST /api/auth/sso` 를 불러 그 사람의 토큰을 받는다. 비밀이 비면 STE 가 꺼지고,
# STE 를 고른 작업은 만들 때 거절 · 이미 건 것은 `ste_auth` 로 끝난다(로컬로 몰래 풀지 않는다). 비밀은 **SimEngBay
# 전용 값**(포털 · 게이트웨이의 것과 다르다) — 요청서와 따로 받는다.
# STE_BASE_URL=https://hwax.sec.samsung.net/ste
# STE_SSO_SECRET=
# `X-Heax-Client` — 비우면 APP_SLUG.
# STE_SSO_CLIENT=
# STE_CALCULIX_APP=calculix
# STE_POLL_SECONDS=15
# 잡 상태를 못 읽어도 참는 시간(초).
# STE_POLL_GRACE_SECONDS=300
# 잡 하나에 청할 메모리 상한(GB) — SPOOLES 어림 x 1.5 가 이것을 넘으면 정적은 반복 솔버로 푼다.
# STE_MEM_GB_MAX=64
# 워커끼리 사람별 STE 토큰을 나눠 둘 폴더. 비우면 /dev/shm/<client>-ste-<uid>(메모리).
# STE_TOKEN_DIR=
# fake 실행기가 단계마다 쉬는 시간(초). 화면의 타임라인이 움직이는 것을 보려면 1~2 를 준다.
# FAKE_STAGE_SECONDS=0
# 작업 폴더의 뿌리. 비우면 <FILESTORE_DIR>/simulations. windows-bridge 면 NTFS 쪽을 준다.
# WORK_DIR=/mnt/c/simengbay/work
# 1 이면 워커 없이 요청 안에서 돌린다(시험 · 워커 없는 작은 설치). run.py 는 이때 워커를 안 띄운다.
# JOBS_INLINE=0
# CAD(CompCore)가 DOE 를 내보내는 **공용 폴더들**, 쉼표로. 가져오기는 이 아래만 볼 수 있다 —
# 비우면 가져오기가 막힌다(아무 경로나 받으면 서버의 모든 폴더를 여는 문이 된다).
# CompCore 의 DOE_EXPORT_ROOT 와 같은 곳을 가리킨다.
# DOE_ROOTS=/mnt/f/data/0_Program/73_CompCore,/data/doe

# --- 온톨로지: Standard Platform 코어 API 에서 받아 온다(SP 연동 지침서 §4.2) ---
# 비우면 수신을 안 한다. 토큰은 SP 시스템 관리자에게 범위 core:read 하나로 받는다.
# ONTOLOGY_SOURCE_URL=https://sp.example.com/api
# ONTOLOGY_SOURCE_TOKEN=standardplatform_pat_xxxxxxxx
# 몇 분마다 받나(기본 하루 1회). 0 이면 화면의 「지금 받기」 로만. 며칠마다 전량 대조하나.
# ONTOLOGY_SYNC_MINUTES=1440
# ONTOLOGY_FULL_DAYS=7

# --- 1.5단계: 진짜 Ansys 로 돌릴 때 (docs/해석-연동-계획.md 3.1) ---
# 개발 PC 의 Ansys 가 Windows 에만 있으면 WSL 의 워커가 Windows 파이썬을 부른다.
# SIMULATION_EXECUTOR=windows-bridge
# WINDOWS_PYTHON=/mnt/c/simengbay/venv/Scripts/python.exe
# WORK_DIR=/mnt/c/simengbay/work        # NTFS 쪽. Ansys 가 \\wsl$ 에 쓰면 느리고 잠금 문제가 난다
# ANSYS_VERSION=252                      # 252 = 2025 R2
# ANSYS_ROOT=                            # 비우면 AWP_ROOT<버전> 환경변수
# SOLVER_PROCESSES=2                     # 워커 수 x 이 값이 기계의 코어를 넘지 않게
# 리눅스 워커(local 실행기)라면 — Ansys 설치 경로와 임베디드를 감싸는 명령.
# ANSYS_ROOT=/ansys_inc/v252
# MECHANICAL_ENV=/ansys_inc/v252/aisol/.workbench_lite

# HWAX 포털로 로그인(ADR 0009) — 비우면 꺼진다(콜백이 404 JSON). 운영 값과 까닭은
# deploy/.env.production.example 의 「HWAX 포털에 붙이기」. Vite 개발 서버도 두 값을 보고 단추를 낸다.
# PORTAL_JWKS_URL=http://<포털>:8088/.well-known/jwks.json
# PORTAL_LAUNCH_URL=https://<포털>/launch/<id>
# 화면(내 정보 › AI 도구 연결)이 보여 줄 MCP 주소 — 비우면 짐작한다(개발은 <호스트>:8072/mcp, ADR 0010).
# MCP_PUBLIC_URL=
# HWAX 게이트웨이의 사람별 위임(POST /api/auth/sso · /sso/verify · /sso/revoke) — 비우면 꺼진다(404).
# 개발에서 확인하려면 아무 긴 값.
# HEAX_SSO_SECRET=
# HEAX_SSO_ALLOWED_IPS=
