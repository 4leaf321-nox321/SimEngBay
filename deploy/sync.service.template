[Unit]
# **Standard Platform 의 온톨로지를 받는다**(backend/scripts/sync_ontology.py --due).
# 타이머(@@APP_SLUG@@-sync.timer)가 5분마다 부르고, 차례가 됐을 때만 받는다 — 차례는
# .env 의 ONTOLOGY_SYNC_MINUTES(기본 하루 1회)가 정한다. 설정(ONTOLOGY_SOURCE_URL ·
# ONTOLOGY_SOURCE_TOKEN)이 없으면 아무것도 안 하고 끝난다.
Description=@@APP_NAME@@ 온톨로지 수신 (Standard Platform 코어 API)
After=@@APP_SLUG@@.service
# 로컬 PostgreSQL 에 묶지 않는다 — 이중화에서는 DB 가 상대 서버에 있을 수 있다(app.service 참고).

[Service]
Type=oneshot
User=@@USER@@
Group=@@USER@@
WorkingDirectory=@@INSTALL_DIR@@

# 앱과 **같은 SIF · 같은 .env** 로 돈다 — 다른 파이썬으로 돌리면 그 둘이 다른 스키마를 볼 수
# 있다. 두 서버가 같은 시각에 돌아도 DB 의 자문 잠금이 한 대만 받게 한다.
ExecStart=/usr/bin/apptainer exec \
    --bind @@ENV_FILE@@:/opt/app/backend/.env:ro \
    --bind @@FILESTORE_DIR@@:/data/filestore \
    --bind @@LOG_DIR@@:/data/logs \
@@BACKUP_BIND@@
    @@INSTALL_DIR@@/app.sif \
    sh -c 'cd /opt/app/backend && exec /opt/app/venv/bin/python scripts/sync_ontology.py --due'

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=false
PrivateTmp=true
