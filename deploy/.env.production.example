# 운영 .env 틀 — deploy.sh 가 설치할 때 이 파일에서 만든다.
#
# **REPLACE_ 자리는 deploy.sh 가 난수로 채운다.** 손으로 만들 때는 직접 넣는다:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# **BOM 없이 UTF-8 로 저장한다.** BOM 이 붙으면 첫 줄 키만 조용히 무시되고,
# APP_ENV 가 기본값으로 떨어져 운영이 development 로 뜬다.

# --- 앱 ---
APP_ENV=production
# **이 설치가 무슨 플랫폼인가.** 번들 하나로 여러 플랫폼을 띄운다 — deploy.sh 가 채운다.
# APP_SLUG 는 소문자·숫자 한 덩어리(32자 이내). DB · 쿠키 · 토큰 · 유닛 이름이 여기서 나오므로
# **설치 뒤에는 바꾸지 않는다.** 이름 · 설명 · 확장은 바꿔도 된다(재시작).
APP_SLUG=REPLACE_APP_SLUG
APP_NAME=REPLACE_APP_NAME
APP_TAGLINE=
# 켤 확장 모듈, 쉼표로(app/extensions/<이름>). 비우면 코어만.
EXTENSIONS=
# 포트는 플랫폼마다 10씩 벌린다. Apptainer 는 호스트 네트워크라 이 값이 곧
# 호스트의 포트다 — 겹치면 나중에 뜬 쪽이 그냥 못 뜬다.
PORT=8070
HOST=0.0.0.0
UVICORN_WORKERS=4

# --- 보안 ---
# 기본값이면 앱이 기동을 거부한다(app/main.py). 그것이 의도다.
JWT_SECRET=REPLACE_WITH_RANDOM_48_CHAR_SECRET
# 로그인 유지 쿠키의 Secure — false 면 요청이 https 일 때만 붙는다(프록시 뒤는 TRUST_PROXY 가
# 판정). true 는 강제라 http 로 들어오면 새로고침마다 로그인 화면이 된다. 보통 false 로 둔다.
REFRESH_COOKIE_SECURE=false

# --- 데이터베이스 ---
# Apptainer 가 호스트 네트워크를 쓰므로 localhost 가 그대로 통한다.
DATABASE_URL=postgresql+psycopg://REPLACE_DB_USER:REPLACE_DB_PASSWORD@localhost:5432/REPLACE_DB_NAME

# --- 컨테이너 안의 경로 ---
#
# **여기 안 적어도 된다.** 이미지가 자기 배치를 알고 있어서(apptainer.def 의
# %environment) LOG_DIR·FILESTORE_DIR 은 /data/logs · /data/filestore 로 온다.
#
# 적어서 바꾸려면 **systemd 유닛의 --bind 대상도 함께** 바꿔야 한다. 한쪽만
# 바꾸면 앱이 마운트 안 된 경로에 쓰게 되고, 기동 가드가 그것을 잡아 준다
# (무엇을 고쳐야 하는지 함께 말한다).
# LOG_DIR=/data/logs
# FILESTORE_DIR=/data/filestore

# --- 백업 ---
# 앱은 이 폴더의 마지막 덤프 시각만 읽어 홈의 「남은 일」 에 올린다. **컨테이너 안에서
# 보이는 경로**여야 한다 — deploy.sh 가 백업 폴더를 알면(공용 스토리지 DATA_DIR, 또는
# BACKUP_HOST_DIR) 유닛이 그것을 /data/backup 에 걸고 여기를 채운다. 안 적으면 「설정이 없다」 로 뜬다.
# BACKUP_DIR=/data/backup

# --- 프록시 뒤 · 경로 접두어 (이중화 · nginx) ---
# https://<호스트>/<slug>/ 로 서비스할 때 — nginx 가 접두어를 떼고 넘기고, 앱은 화면 · 쿠키 ·
# API 주소를 이 아래로 맞춘다. deploy.sh 가 이중화(HA_ROLE)면 채운다.
# PUBLIC_PATH=/<slug>
# X-Forwarded-For · X-Forwarded-Proto 를 믿는다 — 프록시 뒤에서만 true. 프록시 없이 켜면
# 아무나 그 헤더를 위조한다.
# TRUST_PROXY=false

# --- CORS ---
# 배포는 백엔드 한 프로세스가 SPA 까지 서빙하므로 같은 출처다 — 보통 비운다.
# CORS_ORIGINS=["https://app.example.com"]

# 데이터 소스가 파일(CSV·Excel·JSON)을 읽어도 되는 폴더. 비우면 URL 로만 읽는다.
# 이 폴더 아래만 읽는다 — 아무 경로나 읽게 두면 그 화면이 서버의 모든 파일을 읽는 문이 된다.
# 컨테이너 안 경로다: bind-mount 된 filestore 아래를 권장한다.
#DATASOURCE_DIR=/data/filestore/incoming

# --- 해석 작업 ---
# 단계를 어디서 돌리나 — 운영 워커는 이미지 안에서 그대로 돈다(local). 1.5단계 전까지는 fake 라
# 진짜 해석이 아닌 모양만 맞는 산출물이 나온다. 워커 수는 deploy.sh 의 WORKER_COUNT 가 정한다
# (**Mechanical 라이선스 수를 넘기지 않는다**).
SIMULATION_EXECUTOR=fake
# 작업 폴더. 비우면 /data/filestore/simulations — bind-mount 안이라 그대로 두면 된다.
# .mechdb · .dat · .rst 가 쌓이므로 용량을 본다.
# WORK_DIR=/data/filestore/simulations
# CAD(CompCore)가 DOE 를 내보내는 공용 폴더들, 쉼표로. **컨테이너 안에서 보이는 경로**여야
# 하므로 유닛의 --bind 대상과 같아야 한다. 비우면 DOE 가져오기가 막힌다.
# DOE_ROOTS=/data/doe
# 리눅스 워커가 Ansys 를 어디서 보나 — **컨테이너 안에서 보는 경로**다(유닛의 --bind 대상).
# 안 적으면 유닛이 심어 주는 AWP_ROOT<버전> 을 쓴다. 둘 다 없으면 솔버 실행 파일을 못 찾는다.
# ANSYS_ROOT=/ansys_inc/v252
# ANSYS_VERSION=252
# **리눅스 임베디드 Mechanical 은 감싸서 띄워야 한다**(LD_LIBRARY_PATH 등). Ansys 가 함께
# 깔아 주는 스크립트를 적는다. Windows 에는 없고 필요도 없다.
# MECHANICAL_ENV=/ansys_inc/v252/aisol/.workbench_lite

# --- HWAX 포털에 붙이기 (ADR 0009 · 운영 안내서 9절) ---
# 포털 nginx 가 https://<포털>/<id>/ 를 이 앱으로 넘긴다(접두어를 벗겨). 그때 위의 PUBLIC_PATH 는
# 포털의 id 와 같게(/<id> — 보통 /<slug>), TRUST_PROXY=true. 아래 값은 deploy.sh 에 env 로 주면
# 여기에 적힌다(`sudo PORTAL_JWKS_URL=… PORTAL_LAUNCH_URL=… ./deploy.sh update` — 준 것만).
#
# 포털의 공개 키 주소 — **비우면 포털 로그인이 꺼진다**(콜백이 404 JSON). 포털 담당에게 받는다:
# 사내망 http://<포털>:8088/.well-known/jwks.json 이 간단하다(https 면 사내 CA 를 이 서버가 믿어야 한다).
# PORTAL_JWKS_URL=
# 로그인 화면의 「HWAX 포털로 로그인」 이 가는 곳 — 포털의 /launch/<id>. 비우면 단추가 안 뜬다.
# PORTAL_LAUNCH_URL=https://hwax.sec.samsung.net/launch/<id>
# 토큰의 aud(포털 타일의 audience) — 비우면 APP_SLUG. 포털 id 를 slug 와 다르게 지었을 때만.
# PORTAL_AUDIENCE=
# 토큰의 iss(포털의 JWT_ISSUER) — 포털 기본값과 같으면 안 적는다.
# PORTAL_ISSUER=https://hwax.sec.samsung.net
# **포털은 MCP 경로를 열지 않는다**(Report Archive 와 같다) — 사람들의 Claude 는 포털 게이트웨이
# (https://hwax.sec.samsung.net/mcp-gw/mcp)로 붙고, 게이트웨이가 아래 위임으로 이 설치의 MCP 포트를 직접
# 부른다. 화면의 Claude 연결 안내(자기 토큰으로 직접 붙는 사람)가 닿는 주소를 보이게 MCP 포트 주소를 적는다
# — 비우면 화면이 https://<포털>/<id>/mcp 를 짐작하는데 그 길은 없다.
# MCP_PUBLIC_URL=http://<이 서버>:<MCP 포트>/mcp
#
# HWAX 게이트웨이의 사람별 위임(POST /api/auth/sso · /sso/verify · /sso/revoke) — 게이트웨이가 사람마다
# 그 사람 명의의 개인 토큰(하루)을 받아 MCP 를 부른다. **비우면 꺼진다**(404). `sudo ./deploy.sh
# hwax-request` 가 없으면 만들어 여기 적는다(openssl rand -hex 32) — 포털 담당에게는 요청서와 **따로**
# 전한다(게이트웨이 provision.env 의 <접두>_SSO_SECRET). 이미 포털에 전한 값을 바꾸면 그 순간 위임이 전부
# 401 이다 — 바꿀 때는 포털 담당과 같이.
# HEAX_SSO_SECRET=
# 위임 발급을 받아 줄 원격 주소(쉼표 · CIDR, 포털 박스) — 비우면 비밀만 본다. TCP 원격 주소로만 판정하고,
# 목록이 있으면 X-Forwarded-For 가 붙은 요청은 받지 않는다(게이트웨이는 앱 포트로 직접 부른다).
# `sudo HEAX_SSO_ALLOWED_IPS=<주소> ./deploy.sh update` 로도 적는다.
# HEAX_SSO_ALLOWED_IPS=
