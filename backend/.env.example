# 이 파일을 .env 로 복사해서 쓴다. **BOM 없이 UTF-8 로 저장한다** —
# BOM 이 붙으면 첫 줄 키가 조용히 무시된다(app/config.py 주석 참고).
APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/simengbay
# 운영에서는 반드시 난수로 바꾼다. 기본값이면 기동을 거부한다.
JWT_SECRET=dev-only-insecure-secret-change-me

# 이 설치가 무슨 플랫폼인가 — 안 적으면 기본값(SimEngBay · simengbay).
# 개발에서는 확장을 전부 켜 두고 본다. Vite 개발 서버도 이 파일을 읽어 화면에 같은 값을 심는다.
# APP_SLUG=simengbay
# APP_NAME=SimEngBay
# APP_TAGLINE=
# EXTENSIONS=sample

# --- 해석 작업 (로드맵 1단계) ---
# 단계를 어디서 돌리나 — fake(시험 · Ansys 없는 PC) · local · windows-bridge.
# 개발 PC 는 Ansys 가 Windows 에만 있어 1.5단계부터 windows-bridge 를 쓴다(docs/해석-연동-계획.md 3.1).
SIMULATION_EXECUTOR=fake
# fake 실행기가 단계마다 쉬는 시간(초). 화면의 타임라인이 움직이는 것을 보려면 1~2 를 준다.
# FAKE_STAGE_SECONDS=0
# 작업 폴더의 뿌리. 비우면 <FILESTORE_DIR>/simulations. windows-bridge 면 NTFS 쪽을 준다.
# WORK_DIR=/mnt/c/simengbay/work
# 1 이면 워커 없이 요청 안에서 돌린다(시험 · 워커 없는 작은 설치). run.py 는 이때 워커를 안 띄운다.
# JOBS_INLINE=0
# CAD(CompCore)가 DOE 를 내보내는 **공용 폴더들**, 쉼표로. 가져오기는 이 아래만 볼 수 있다 —
# 비우면 가져오기가 막힌다(아무 경로나 받으면 서버의 모든 폴더를 여는 문이 된다).
# CompCore 의 DOE_EXPORT_ROOT 와 같은 곳을 가리킨다.
# DOE_ROOTS=/mnt/f/data/0_Program/73_CompCore,/data/doe

# --- 1.5단계: 진짜 Ansys 로 돌릴 때 (docs/해석-연동-계획.md 3.1) ---
# 개발 PC 의 Ansys 가 Windows 에만 있으면 WSL 의 워커가 Windows 파이썬을 부른다.
# SIMULATION_EXECUTOR=windows-bridge
# WINDOWS_PYTHON=/mnt/c/simengbay/venv/Scripts/python.exe
# WORK_DIR=/mnt/c/simengbay/work        # NTFS 쪽. Ansys 가 \\wsl$ 에 쓰면 느리고 잠금 문제가 난다
# ANSYS_VERSION=252                      # 252 = 2025 R2
# ANSYS_ROOT=                            # 비우면 AWP_ROOT<버전> 환경변수
# SOLVER_PROCESSES=2                     # 워커 수 x 이 값이 기계의 코어를 넘지 않게
# 리눅스 워커(local 실행기)라면 — Ansys 설치 경로와 임베디드를 감싸는 명령.
# ANSYS_ROOT=/ansys_inc/v252
# MECHANICAL_ENV=/ansys_inc/v252/aisol/.workbench_lite
